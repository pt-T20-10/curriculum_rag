{$APP_DOMAIN} {
	basic_auth {
		{$DEMO_BASIC_AUTH_USER} {$DEMO_BASIC_AUTH_HASH}
	}

	encode zstd gzip

	root * /srv

	route {
		@backend path /api/* /outputs/* /docs* /redoc* /openapi.json
		reverse_proxy @backend api:8000

		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Allow the built-in same-origin PDF viewer without permitting other
		# websites to frame the application.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}
