# Copy to .env.production, replace every REPLACE_* value, then chmod 600.
APP_DOMAIN=demo.example.com
DEMO_BASIC_AUTH_USER=reviewer
DEMO_BASIC_AUTH_HASH='REPLACE_WITH_CADDY_PASSWORD_HASH'
IMAGE_TAG=demo

ENVIRONMENT=production
FRONTEND_URL=https://demo.example.com
BACKEND_URL=https://demo.example.com
CORS_ORIGINS=https://demo.example.com
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REMEMBER_ME_EXPIRE_DAYS=30

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ai_textbook_db
MYSQL_USER=textbook_user
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DATABASE_ROOT_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_CONCURRENCY=1

OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
SERPER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://demo.example.com/api/v1/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=REPLACE_WITH_EMAIL_FROM

SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=REPLACE_WITH_DEMO_BANK_ACCOUNT

DEFAULT_ADMIN_ENABLED=true
DEFAULT_ADMIN_EMAIL=demo-admin@example.com
DEFAULT_ADMIN_USERNAME=demo-admin
DEFAULT_ADMIN_FULL_NAME=Demo Administrator
DEFAULT_ADMIN_PASSWORD_HASH='REPLACE_WITH_BCRYPT_PASSWORD_HASH'

# Low-memory profile for a 2 GB VPS. Do not raise concurrency before RAG isolation.
SEARCH_MAX_WORKERS=2
CRAWL_MAX_WORKERS=2
URL_FILTER_MAX_WORKERS=2
MAX_CHUNKS_TO_EMBED=300
EMBEDDING_BATCH_SIZE=100
CHROMADB_BATCH_SIZE=100

ENABLE_PROMPT_LOGS=false
LOG_TO_FILES=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3
DOCUMENT_FONT=Liberation Serif

